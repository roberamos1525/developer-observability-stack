# Copy to .env (never commit .env). All variables are optional unless noted.

# Listen address and data directory.
OBS_LISTEN_ADDR=127.0.0.1:8428
OBS_DATA_DIR=./var/data

# Optional JSON config file; environment variables override its values.
# OBS_CONFIG=./examples/config/obsd.local.json

# Logging: debug | info | warn | error, and json | text.
OBS_LOG_LEVEL=info
OBS_LOG_FORMAT=json

# Authentication is on by default and then requires at least one key.
# Format: tenant:key[:scope+scope];tenant2:key2  (scopes: read, write, admin;
# default read+write). Keys must be at least 8 characters.
OBS_AUTH_ENABLED=true
OBS_API_KEYS=demo:change-me-demo-key:read+write+admin
# With OBS_AUTH_ENABLED=false the X-Tenant-ID header (or this default) selects the tenant.
OBS_DEFAULT_TENANT=default

# HMAC secret for a webhook channel configured with "secret_env": "OBS_WEBHOOK_SECRET".
OBS_WEBHOOK_SECRET=change-me-webhook-secret

# Ingestion worker pool and queue sizing.
OBS_INGEST_WORKERS=4
OBS_INGEST_QUEUE_CAPACITY=1024

# Retention per signal (Go durations plus d/w units).
OBS_LOGS_RETENTION=7d
OBS_METRICS_RAW_RETENTION=15d
OBS_METRICS_DOWNSAMPLED_RETENTION=90d
OBS_TRACES_RETENTION=3d

# Background loop intervals.
OBS_ALERT_EVAL_INTERVAL=15s
OBS_RETENTION_INTERVAL=1m
OBS_SCRAPE_INTERVAL=15s

# Used by cmd/loadgen when -api-key is not given.
OBS_API_KEY=change-me-demo-key
